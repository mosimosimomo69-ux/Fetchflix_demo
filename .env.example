# TMDB v4 Read Access Token (create one free at https://www.themoviedb.org/settings/api)
# Use TMDB_API_KEY (NOT NEXT_PUBLIC_) to keep this secret server-side only.
# It is never sent to the browser this way.
TMDB_API_KEY=

# Legacy (still accepted as fallback, but prefer TMDB_API_KEY above)
# NEXT_PUBLIC_TMDB_API_KEY=
